# bds-lab の設定。このファイルを .env という名前でコピーして、使うものだけ書いてください（空欄は未設定）。
# .env と .env.local（node lab.mjs login が書く）は git にも zip にもパッチにも入りません。このPCの中だけです。
# パスワードと 2 段階認証の秘密は、ラボが「このPCのブラウザで、そのサービスのログイン画面に入れる」ためだけに使い、
# 環境変数にも、サーバーにも、AI にも渡しません。書かなければ、login のときに聞かれます（入力は表示されません）。

# ---- AI（make / maintain / playtest / i18n --ai。どれか 1 つ）----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI 互換のサーバー（ローカル LLM など）とモデル
OPENAI_BASE_URL=
OPENAI_MODEL=
# 使うモデル（空欄ならラボの既定）と、1 回の make で使ってよいトークンの上限
LAB_MODEL=
LAB_TOKEN_BUDGET=
# 小さな仕事（i18n --ai の翻訳）に使うモデル（空欄なら小さく安いもの）
LAB_SMALL_MODEL=

# ---- GitHub（node lab.mjs login github。github / ship / publish / CI で使う）----
# トークンがあればブラウザ不要（repo と workflow の権限）: https://github.com/settings/tokens
GH_TOKEN=
# または、ユーザー名（かメールアドレス）とパスワード: ブラウザが開いて自動で入力します
GITHUB_USER=
GITHUB_PASSWORD=
# 2 段階認証の秘密（認証アプリに登録した base32 の文字列）。書けば 6 桁のコードも自動で入力します。
# 注意: パスワードと同じ場所に置くと、このPCを使える人には 2 段階認証が効かなくなります
GITHUB_TOTP_SECRET=

# ---- Google（node lab.mjs login google。app ラボで Minecraft の APK を Google Play から取るときだけ）----
# アドレスとパスワードがあれば全自動（入力・「同意する」・途中の「後で」までラボが押す）。無ければ login のときに聞きます
GOOGLE_EMAIL=
GOOGLE_PASSWORD=
GOOGLE_TOTP_SECRET=

# ---- Microsoft / Xbox（node lab.mjs login microsoft <名前>。lan で本物のワールドに入るボットのアカウント）----
MS_EMAIL=
MS_PASSWORD=

# ---- 通知（make / maintain / 最新版チェックの結果）: Discord・Slack の Webhook URL か https://ntfy.sh/<トピック> ----
LAB_NOTIFY_WEBHOOK=

# ---- Discord のボット（スマホから: app hold の画面とボタン、secrets ワークフローの秘密のフォーム）。ふつうは GitHub の Secrets に ----
# 自分のボットのトークンと、自分の Discord のユーザー ID（数字）。app/README.md「スマホだけで」
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=
