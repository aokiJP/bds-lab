{
  "$comment": "bds-lab: an AI here needs only Bash (node lab.mjs ...), Read, Write, Edit, Glob, Grep. Every other tool's definition is resent on every turn (measured: 33,065 → 6,146 tokens per turn with the same AGENTS.md). Newer Claude Code tools (tasks, plan mode, questions, cron, worktrees, monitor, LSP, ...) are listed too; a name a version does not have matches nothing. Background commands stay (node lab.mjs bg/wait does the same). The lab's own commands, git and the GitHub CLI run without asking. MCP: none (mcp__*), to keep the tokens down; a GitHub repository is never deleted from here (the PreToolUse hook). To get the other tools back in this folder, delete this file.",
  "permissions": {
    "allow": [
      "Bash(node lab.mjs:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(node .fanout/fanout.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git worktree:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "NotebookRead",
      "TodoWrite",
      "SlashCommand",
      "Workflow",
      "mcp__*",
      "Bash(gh repo delete:*)",
      "Bash(gh api -X DELETE repos/:*)",
      "Bash(gh api -X DELETE /repos/:*)",
      "Bash(gh api --method DELETE repos/:*)",
      "Bash(gh api --method DELETE /repos/:*)",
      "EnterPlanMode",
      "ExitPlanMode",
      "CronCreate",
      "CronDelete",
      "CronList",
      "Monitor",
      "PushNotification",
      "SendMessage",
      "LSP",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "DesignSync",
      "ListAgents",
      "ReadNotifications",
      "RefreshMcpTools",
      "ReportFindings",
      "ScheduleWakeup",
      "SendUserFile",
      "SendUserMessage",
      "ShowOnboardingRolePicker",
      "SearchPlugins",
      "SuggestPluginInstall",
      "SuggestSkills",
      "ListPlugins",
      "ListSkills",
      "SearchSkills",
      "ListConnectors",
      "SearchMcpRegistry",
      "SuggestConnectors",
      "propose_skills"
    ]
  },
  "model": "opus",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .fanout/fanout.mjs brief"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node lab.mjs panel hook",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/no-repo-delete.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
