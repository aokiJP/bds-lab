{
  // Forms whose title contains the marker §d§e§m§o are drawn by demo_form; every other form keeps the vanilla look.
  "namespace": "server_form",

  "long_form": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "vanilla_form@server_form.vanilla_long_form": {
          "bindings": [
            { "binding_name": "#title_text" },
            { "binding_type": "view", "source_property_name": "((#title_text - '§d§e§m§o') = #title_text)", "target_property_name": "#visible" }
          ]
        }
      },
      {
        "demo_form@server_form.demo_form": {
          "bindings": [
            { "binding_name": "#title_text" },
            { "binding_type": "view", "source_property_name": "(not ((#title_text - '§d§e§m§o') = #title_text))", "target_property_name": "#visible" }
          ]
        }
      }
    ]
  },

  // the vanilla long form, unchanged
  "vanilla_long_form@common_dialogs.main_panel_no_buttons": {
    "$title_panel": "common_dialogs.standard_title_label",
    "$title_size": ["100% - 15px", 10],
    "$title_max_size": ["100% - 15px", 10],
    "size": [225, 200],
    "$text_name": "#title_text",
    "$title_text_binding_type": "none",
    "$child_control": "server_form.long_form_panel",
    "layer": 2
  },

  // the demo's own look: a dark card with a gold header band, the body text and the vanilla button list
  "demo_form": {
    "type": "image",
    "texture": "textures/ui/White",
    "color": [0.08, 0.09, 0.13],
    "alpha": 0.95,
    "size": [280, 210],
    "layer": 2,
    "controls": [
      {
        "header": {
          "type": "image",
          "texture": "textures/ui/White",
          "color": [0.93, 0.72, 0.18],
          "size": ["100%", 26],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 1,
          "controls": [
            {
              "title": {
                "type": "label",
                "text": "#title_text",
                "color": [0.08, 0.09, 0.13],
                "font_scale_factor": 1.4,
                "anchor_from": "center",
                "anchor_to": "center",
                "layer": 2,
                "bindings": [{ "binding_name": "#title_text" }]
              }
            },
            { "close@common.close_button": { "$close_button_offset": [-3, 3], "layer": 3 } }
          ]
        }
      },
      {
        "body": {
          "type": "label",
          "text": "#form_text",
          "color": [0.85, 0.87, 0.92],
          "size": ["100% - 16px", "default"],
          "offset": [8, 32],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "layer": 2,
          "bindings": [{ "binding_name": "#form_text" }]
        }
      },
      {
        "buttons@server_form.long_form_dynamic_buttons_panel": {
          "size": ["100% - 16px", "100%c"],
          "offset": [0, 56],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 2
        }
      }
    ]
  }
}
