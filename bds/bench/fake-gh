#!/usr/bin/env python3
# Minimal fake GitHub CLI for bds-lab smoke tests. State lives in $FAKEGH (bare repos, variables, releases).
import os, sys, json, shutil, subprocess
S = os.environ['FAKEGH']; USER = 'tester'
a = sys.argv[1:]
log = open(os.path.join(S, 'calls.log'), 'a'); log.write(' '.join(a) + '\n'); log.close()
def repo_dir(slug): return os.path.join(S, slug + '.git')
def cur_slug():
    if '--repo' in a: return a[a.index('--repo') + 1]
    url = subprocess.run(['git', 'config', '--get', 'remote.origin.url'], capture_output=True, text=True).stdout.strip()
    return url.split('github.com/')[-1].removesuffix('.git')
def rel_dir(tag): return os.path.join(S, 'releases', cur_slug().replace('/', '__'), tag)
if a[:1] == ['--version']: print('gh fake'); sys.exit(0)
if a[:2] == ['auth', 'status']: sys.exit(0)
if a[:2] == ['api', 'user']: print(USER); sys.exit(0)
if a[:1] == ['api']:
    if 'contents/lib/core.mjs' in ' '.join(a): sys.exit(1)
    sys.exit(0)
if a[:2] == ['repo', 'view']: sys.exit(0 if os.path.isdir(repo_dir(a[2])) else 1)
if a[:2] == ['repo', 'create']:
    name = a[2]; slug = f'{USER}/{name}'
    os.makedirs(os.path.dirname(repo_dir(slug)), exist_ok=True)
    subprocess.run(['git', 'init', '-q', '--bare', repo_dir(slug)], check=True)
    if '--source' in a:
        src = a[a.index('--source') + 1]
        subprocess.run(['git', 'remote', 'add', 'origin', f'https://github.com/{slug}.git'], cwd=src)
        subprocess.run(['git', 'push', '-q', '-u', 'origin', 'main'], cwd=src, check=True)
    open(os.path.join(repo_dir(slug), 'visibility'), 'w').write('public' if '--public' in a else 'private')
    sys.exit(0)
if a[:2] == ['repo', 'edit']: sys.exit(0)
if a[:2] == ['variable', 'get']: sys.exit(0 if os.path.exists(os.path.join(repo_dir(a[a.index('--repo')+1]), 'VAR_' + a[2])) else 1)
if a[:2] == ['variable', 'set']: open(os.path.join(repo_dir(a[a.index('--repo')+1]), 'VAR_' + a[2]), 'w').write('1'); sys.exit(0)
if a[:1] == ['release']:
    op, tag = a[1], a[2]; d = rel_dir(tag)
    meta = os.path.join(d, '_meta')
    def keep_notes():
        if '--notes' in a: open(meta, 'w').write(json.dumps({'body': a[a.index('--notes') + 1]}))
    if op == 'view':
        if not os.path.isdir(d): sys.exit(1)
        body = json.load(open(meta)).get('body', '') if os.path.exists(meta) else ''
        print(json.dumps({'assets': [{'name': n} for n in sorted(os.listdir(d)) if n != '_meta'], 'body': body})); sys.exit(0)
    if op == 'create':
        os.makedirs(d, exist_ok=True); keep_notes()
        for f in [x for x in a[3:] if os.path.isfile(x)]: shutil.copy(f, d)
        sys.exit(0)
    if op == 'edit':
        if not os.path.isdir(d): sys.exit(1)
        keep_notes(); sys.exit(0)
    if op == 'upload':
        for f in [x for x in a[3:] if os.path.isfile(x)]: shutil.copy(f, d)
        sys.exit(0)
    if op == 'download':
        name = a[a.index('-p') + 1]; out = a[a.index('-D') + 1]; os.makedirs(out, exist_ok=True)
        src = os.path.join(d, name)
        if not os.path.exists(src): sys.exit(1)
        shutil.copy(src, out); sys.exit(0)
    if op == 'delete-asset':
        p = os.path.join(d, a[3])
        if os.path.exists(p): os.remove(p)
        sys.exit(0)
print('fake gh: unsupported ' + ' '.join(a), file=sys.stderr); sys.exit(2)
