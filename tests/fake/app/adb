  else if (/^input tap \d+ \d+$/.test(sh) && S.dead) { S.phase = 'world'; S.dead = false; save(); }
  // Android's crash records: one app crash when the player never joins (FAKE_NOJOIN)
  else if (/^dumpsys dropbox --print data_app_crash$/.test(sh) && process.env.FAKE_NOJOIN) say('Drop box contents: 1 entries\n========================================\n2026-10-03 00:40:00 data_app_crash (text, 300 bytes)\nProcess: com.mojang.minecraftpe\nPID: 4242\n\njava.lang.IllegalStateException: boom\n\tat a.b.C.d(C.java:1)\n');
  else if (/^dumpsys dropbox/.test(sh)) say('Drop box contents: 0 entries\n');
  else if (/^ls /.test(sh)) process.exit(1);
}
